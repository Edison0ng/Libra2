# Tambahkan dua baris berikut ke file .env pada project Laravel Anda.
# Nilainya diambil dari Supabase Dashboard -> Project Settings -> API.

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=ey... (Service Role Key, BUKAN anon/public key)

# Catatan keamanan:
# - SUPABASE_SERVICE_KEY punya akses penuh ke database (bypass RLS).
# - Kunci ini HANYA boleh berada di server (.env Laravel), JANGAN PERNAH
#   dikirim atau ditulis di kode JavaScript sisi client (frontend).
# - Pastikan .env ada di .gitignore agar tidak ter-commit ke repository.
