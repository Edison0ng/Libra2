APP_NAME=LIBRA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# ===================== KONEKSI KE SUPABASE (POSTGRESQL) =====================
# Ambil nilai ini dari Supabase Dashboard -> Project Settings -> Database -> Connection string
# Gunakan mode "Session" (port 5432) untuk migration, atau "Transaction" (port 6543) utk runtime.
DB_CONNECTION=pgsql
DB_HOST=db.xxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=isi_password_supabase_kamu

# ===================== SESSION / SANCTUM =====================
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Domain frontend yang boleh mengakses (dipisah koma jika lebih dari satu)
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:5500,localhost:5500

# ===================== CORS - DIPAKAI config/cors.php =====================
# Local dev:
FRONTEND_URL=http://127.0.0.1:5500,http://localhost:5500
# Production (isi ini di dashboard Railway, JANGAN di file .env yang di-commit):
# FRONTEND_URL=https://libra-fmipa.vercel.app
